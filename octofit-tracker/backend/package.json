{
  "name": "octofit-tracker-backend",
  "private": true,
  "version": "0.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev --transpile-only --exit-child src/scripts/seed.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.0",
    "mongoose": "^9.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
